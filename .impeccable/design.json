      "css": ".ds-settings{display:inline-flex;align-items:center;justify-content:center;width:44px;height:44px;padding:0;border:0;border-radius:10px;background:#0d0e14;color:#b2b3c3;cursor:pointer;transition:background-color 180ms ease}.ds-settings svg{width:24px;height:24px;stroke:currentColor;stroke-width:1.7}.ds-settings:hover{background:#2a283b}.ds-settings:focus-visible{outline:2px solid #c9b6ff;outline-offset:-2px}@media(prefers-reduced-motion:reduce){.ds-primary,.ds-nav-button,.ds-settings{transition:none}}"
