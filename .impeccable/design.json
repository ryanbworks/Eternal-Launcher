  "narrative": {
    "northStar": "Portal observation console",
    "overview": "Eternal uses graphite and indigo surfaces, violet active controls and a geometric portal E to give a private Minecraft launcher a dark, futuristic identity. A cinematic voxel landscape supplies atmosphere; a calm access console makes identity, installation readiness and the next action easy to read.\n\nThe system is a native Windows application built with Win32 and GDI+. Sora Bold gives the wordmark and hero a distinct voice, while Segoe UI keeps controls and operational copy familiar and compact. Tonal layers, precise hairlines and generous separation organize the information without shadows or ornamental motion.",
    "keyCharacteristics": [
      "Graphite field, indigo layers and restrained violet emphasis.",
      "Sora display type paired with Segoe UI for native interaction.",
      "One environmental illustration and a geometric portal monogram.",
      "Continuous access surfaces and flat status groups.",
      "Semantic states, visible keyboard focus and motion tied to activity."
    ],
    "rules": [
      {
        "name": "Action Violet",
        "body": "Reserve violet emphasis for identity, selection, focus and the primary action; use semantic state colors to explain service results.",
        "section": "colors"
      },
      {
        "name": "Display and Control",
        "body": "Use the embedded Sora Bold for the hero and wordmark. Keep interactive controls, body copy and status text in Segoe UI.",
        "section": "typography"
      },
      {
        "name": "Quiet Depth",
        "body": "Use tonal surfaces, hairlines and the artwork's atmospheric depth. Do not add interface drop shadows to this system.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use the Theme.h palette and the documented semantic state mapping.",
      "Do preserve native window controls, text editing, keyboard order and visible focus.",
      "Do pair status colors with readable labels and concrete operation messages.",
      "Do respect the Windows client-area animation preference and stop the animation timer when activity settles.",
      "Do describe the landscape as concept art and label sample news as demonstration content.",
      "Do verify the native layout and edit control at the intended DPI and window size."
    ],
