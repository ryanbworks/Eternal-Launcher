# Artifacts generated by CMake and Visual Studio.
/out/
/.vs/
/build/

# Binaries, libraries and debug symbols.
*.exe
*.dll
*.lib
*.obj
*.pdb
*.ilk

# Local IDE and operating system files.
*.user
*.suo
*.VC.db
*.VC.opendb
.DS_Store
Thumbs.db

# Local settings that may contain user-specific paths.
config.local.json
launcher-settings.json

# Python cache and reproducible intermediate frames from visual validation.
__pycache__/
*.py[cod]
/.impeccable/review/motion/*.png
/.impeccable/review/navigation-performance/*.png
