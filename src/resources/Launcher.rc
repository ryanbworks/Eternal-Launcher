#include <windows.h>
#include "config/LauncherVersion.h"

// The launcher identity is embedded so the distributed executable stays self-contained.
1 VERSIONINFO
FILEVERSION ETERNAL_VERSION_RESOURCE
PRODUCTVERSION ETERNAL_VERSION_RESOURCE
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Eternal Launcher"
            VALUE "FileVersion", ETERNAL_VERSION_RESOURCE_TEXT
            VALUE "ProductName", "Eternal Launcher"
            VALUE "ProductVersion", ETERNAL_VERSION_RESOURCE_TEXT
            VALUE "OriginalFilename", "EternalLauncher.exe"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
101 ICON "../../assets/eternal.ico"
102 RCDATA "../../assets/realm.png"
103 RCDATA "../../assets/fonts/Sora-Bold.ttf"
104 RCDATA "../../assets/fonts/OFL.txt"
105 RCDATA "../../assets/lavender-cosmic-portal.png"
